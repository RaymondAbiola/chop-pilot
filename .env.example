# SERV Reasoning (OpenServ). Key from https://console.openserv.ai/settings/keys
SERV_API_KEY=
SERV_MODEL=gpt-5.6-luna

# Coinbase Developer Platform. https://portal.cdp.coinbase.com
# API key and wallet secret are created separately.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

NETWORK_ID=base-sepolia

# ChopEazy merchant address that receives USDC recharges.
MERCHANT_ADDRESS=

CHOPEAZY_MOCK_URL=http://localhost:4000
AGENT_URL=http://localhost:4100
