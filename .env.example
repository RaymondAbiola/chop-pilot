# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# SERV Reasoning (OpenServ)
# Key: https://console.openserv.ai/settings/keys  (shown once)
# Balance: https://console.openserv.ai/usage
# ---------------------------------------------------------------------------
SERV_API_KEY=
# Cheapest capable model for the decision loop. ~$0.0007 per decision.
# Alternatives: gemini-3.1-flash-lite, claude-haiku-4.5
SERV_MODEL=gpt-5.6-luna

# ---------------------------------------------------------------------------
# Coinbase Developer Platform
# API key:      https://portal.cdp.coinbase.com/access/api
# Wallet secret: Portal > Wallets > Non-custodial wallet > Security
# All three are required before the agent can sign anything.
# ---------------------------------------------------------------------------
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# ---------------------------------------------------------------------------
# Chain
# ---------------------------------------------------------------------------
NETWORK_ID=base-sepolia

# The address that receives USDC recharges, standing in for ChopEazy's
# merchant account. Any address you control. Must NOT be the agent wallet,
# or the agent pays itself and the demo proves nothing.
MERCHANT_ADDRESS=

# Public x402 facilitator. Override only if it proves flaky; the CDP-hosted
# facilitator is the fallback and needs the API key but no wallet secret.
FACILITATOR_URL=https://x402.org/facilitator

# ---------------------------------------------------------------------------
# Local services
# ---------------------------------------------------------------------------
MOCK_PORT=4000
CHOPEAZY_MOCK_URL=http://localhost:4000
AGENT_URL=http://localhost:4100

# Read by the browser, so these must be the URLs a visitor can reach.
NEXT_PUBLIC_AGENT_URL=http://localhost:4100
NEXT_PUBLIC_MOCK_URL=http://localhost:4000
DB_PATH=chopeazy.sqlite
